# Server
NODE_ENV=development
PORT=3000
WS_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=nakhoda
DB_PASSWORD=nakhoda
DB_NAME=nakhoda

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Rudder tokens (comma-separated list of valid tokens)
RUDDER_TOKENS=rudder_token_1,rudder_token_2

# Job settings
JOB_RETENTION_DAYS=30
JOB_TIMEOUT_MS=300000

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
