# Nakhoda Environment Variables

## Database
DB_URL=postgres://nakhoda:nakhoda@localhost:5432/nakhoda
DB_POOL_MIN=2
DB_POOL_MAX=10

## Redis (Cache)
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL_SECONDS=10

## Wheel Backend
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

## WebSocket
WS_PORT=8080
WS_CORS_ORIGIN=http://localhost:5173

## Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
SESSION_TIMEOUT_MS=86400000

## Rudder Tokens (comma-separated)
RUDDER_TOKENS=token_rudder_1,token_rudder_2,token_rudder_3

## Job Configuration
JOB_RETENTION_DAYS=30
JOB_TIMEOUT_MS=300000

## Rudder Health
HEARTBEAT_INTERVAL_MS=30000
RUDDER_OFFLINE_THRESHOLD_MS=60000

## Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=60000

## Monitoring
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

## Frontend (Wheel FE)
VITE_API_URL=http://localhost:3000/api
VITE_WS_URL=ws://localhost:8080

## Rudder Agent
WHEEL_URL=wss://localhost:443
RUDDER_TOKEN=token_rudder_1
RUDDER_ID=rudder_1
RUDDER_HOSTNAME=docker-host-1
