FROM node:20-alpine

WORKDIR /app

# Install build tools required for native modules (dockerode, etc)
RUN apk add --no-cache python3 make g++

# Install pnpm
RUN npm install -g pnpm

# Copy package files
COPY rudder/package.json ./
COPY shared/package.json ../shared/

# Install dependencies
RUN pnpm install

# Copy shared types
COPY shared ../shared

# Copy source code
COPY rudder/src ./src
COPY rudder/tsconfig.json ./

# Expose port (if needed for debugging)
EXPOSE 9229

# Start development server
CMD ["pnpm", "run", "dev"]
